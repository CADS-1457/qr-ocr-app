# Domaine dédié au portail de réservation en ligne (exemple, NON activé).
# 1. DNS : créer l'enregistrement A/AAAA de rdv.example.be vers ce serveur.
# 2. Certificat : docker compose -f docker-compose.yml -f docker-compose.https.yml run --rm certbot certonly --webroot -w /var/www/certbot -d rdv.example.be
# 3. Remplacer rdv.example.be ci-dessous, copier ce fichier en nginx/portail.conf et le monter dans
#    nginx-https (volume : ./nginx/portail.conf:/etc/nginx/conf.d/portail.conf:ro), puis redémarrer nginx-https.
# 4. Renseigner SMTP_* dans .env et activer le portail dans « Réservation en ligne ».

limit_req_zone $binary_remote_addr zone=portal_api:10m rate=5r/s;

server {
    listen 80;
    server_name rdv.example.be;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name rdv.example.be;

    ssl_certificate     /etc/letsencrypt/live/rdv.example.be/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rdv.example.be/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    # Seule la page du portail est exposée : ni l'application interne, ni l'API d'administration.
    location = / {
        proxy_pass http://frontend:80/portail.html;
        proxy_set_header Host $host;
    }
    location = /portail.html {
        proxy_pass http://frontend:80/portail.html;
        proxy_set_header Host $host;
    }

    location /api/portal/ {
        limit_req zone=portal_api burst=20 nodelay;
        client_max_body_size 16k;
        proxy_pass http://api:8000/api/portal/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / { return 404; }
}
