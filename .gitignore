# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
backend/venv/

# VS Code / IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs / runtime
*.log
logs/
tmp/
temp/

